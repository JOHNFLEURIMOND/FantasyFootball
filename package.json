{
  "name": "fantasyfootball",
  "version": "0.1.0",
  "private": true,
  "description": "Public NFL and fantasy football dashboard backed by validated canonical data APIs.",
  "author": "John Fleurimond",
  "repository": {
    "type": "git",
    "url": "https://github.com/JOHNFLEURIMOND/FantasyFootball.git"
  },
  "keywords": [
    "fantasy-football",
    "nfl",
    "nflverse",
    "react",
    "express"
  ],
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "prebuild": "npm run validate:env",
    "build": "webpack --mode production",
    "dev": "webpack-dev-server --mode development --open",
    "serve": "concurrently \"npm run dev\" \"npm run server\"",
    "start": "node server.js",
    "ingest:nflverse": "node scripts/ingest-nflverse.js",
    "lint": "node scripts/lint.js",
    "test:a11y": "node --test test/accessibilityBaseline.test.js",
    "validate:env": "node scripts/validate-env.js",
    "prettier": "npx prettier --write .",
    "server": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@emotion/core": "^11.0.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "better-sqlite3": "^11.10.0",
    "body-parser": "^1.20.2",
    "concurrently": "^8.2.2",
    "core-js": "^3.38.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "formik": "^2.4.6",
    "graphql": "^16.9.0",
    "gulp": "^5.0.0",
    "http-proxy-middleware": "^3.0.0",
    "ityped": "^1.0.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "portfinder": "^1.0.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.2.1",
    "react-query": "^3.39.3",
    "react-transition-group": "^4.4.5",
    "regenerator-runtime": "^0.14.1",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "styled-components": "^6.1.12",
    "styled-system": "^5.1.5",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1",
    "web-vitals": "^4.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@babel/register": "^7.29.7",
    "babel-loader": "^9.1.3",
    "babel-plugin-styled-components": "^2.1.4",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "html-webpack-plugin": "^5.6.0",
    "image-minimizer-webpack-plugin": "^4.1.0",
    "image-webpack-loader": "^8.1.0",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.9.0",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "supertest": "^7.2.2",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.93.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^6.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
