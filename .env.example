# Runtime mode. Allowed values: development, test, production.
NODE_ENV=development

# Local Express server port. Netlify Functions do not use this value.
PORT=8080

# Local SQLite database used by ingestion and persistence tooling.
# Keep this on a durable local filesystem. Netlify Functions must not rely on
# this file for persistent production storage.
NFL_DATA_DB_PATH=./data/nfl-data.sqlite
